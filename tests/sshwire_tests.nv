// sshwire_tests.nv — the packet layer, the wire encodings, the
// negotiation rule and the exchange hash.
//
// RED ON PURPOSE: every body under `src/` is a `todo()`, so every
// assertion here reaches `not implemented: ssh-nv.<module>.<fn>`.
//
// NOT ONE OF THESE TESTS OPENS A SOCKET OR DRAWS A RANDOM NUMBER.  The
// padding, the KEXINIT cookie and the ephemeral secret are all
// arguments, so a whole handshake is a value a test writes out and the
// same inputs produce the same bytes every run.

use std.test
use sshfault
use sshkex
use sshpkt

// `n` bytes of fixture.  The values do not matter — every assertion
// here is about a length, a flag or a refusal — so the zeroes are the
// honest filler and not a placeholder for something better.
fn some_bytes(n: Int) -> [u8]
    list.zeros(n)

fn a_kex_init(kex: [Str], cipher: [Str]) -> SshKexInit
    SshKexInit { cookie: some_bytes(16), kex_algorithms: kex,
                 host_key_algorithms: ["ssh-ed25519"],
                 cipher_client_to_server: cipher, cipher_server_to_client: cipher,
                 mac_client_to_server: ["none"], mac_server_to_client: ["none"],
                 compression_client_to_server: ["none"],
                 compression_server_to_client: ["none"],
                 first_kex_packet_follows: false }

@test
fn test_the_packet_length_is_encrypted_so_framing_needs_the_key() [io]
    // `chacha20-poly1305@openssh.com` uses TWO keys: K_1 encrypts the
    // four-byte length and K_2 the payload.  A reader that looked at the
    // first four bytes and trusted them reads garbage and then reads the
    // wrong number of bytes forever.
    let r = sshpkt.reader(sshpkt.SSH_PACKET_MAX)

    test.case("a reader with no bytes wants some")
    match sshpkt.step(r, [])
        SshReadNeedBytes(n) => test.assert(n > 0)
        _                   => test.fail("an empty reader has no packet")

    test.case("and the key material is 64 bytes: two 32-byte keys")
    test.assert_eq(sshkex.SSH_CHACHA_KEY_BYTES, 64)

@test
fn test_the_sequence_number_is_counted_and_never_sent() [io]
    // Both sides count from zero and the count goes into the nonce and
    // the MAC; nothing on the wire carries it.
    let r = sshpkt.reader(sshpkt.SSH_PACKET_MAX)
    let w = sshpkt.writer()

    test.case("both start at zero")
    test.assert_eq(r.sequence, 0)
    test.assert_eq(w.sequence, 0)

    test.case("and a rekey does NOT reset them")
    test.assert_eq(sshpkt.rekeyed_writer(sshpkt.wrote(w, 64)).sequence,
                   sshpkt.wrote(w, 64).sequence)

@test
fn test_a_packet_carries_at_least_four_bytes_of_random_padding() [io]
    // The padding is random, it is inside the encryption, and it is
    // what stops a passive observer reading the exact length of a
    // password off the packet size.
    test.case("the floor is four bytes")
    test.assert_eq(sshpkt.SSH_PADDING_MIN, 4)

    test.case("and the padding for a payload is at least that")
    test.assert(sshpkt.padding_len(10, []) >= sshpkt.SSH_PADDING_MIN)

    test.case("the framed length accounts for it")
    test.assert(sshpkt.framed_len(10, []) >= 10 + sshpkt.SSH_PADDING_MIN)

@test
fn test_a_packet_over_the_ceiling_is_refused_before_it_is_allocated() [io]
    // The length field is 32 bits and it arrives before anything is
    // authenticated, so a client without a ceiling allocates whatever
    // the first four bytes said.
    test.case("the specification's floor for the ceiling is 35000")
    test.assert_eq(sshpkt.SSH_PACKET_MAX, 35000)

    test.case("and a reader carries one")
    test.assert_eq(sshpkt.reader(4096).limit, 4096)

@test
fn test_an_mpint_gets_a_leading_zero_when_its_top_bit_is_set() [io]
    // A shared secret whose first byte is above 0x7F needs a zero in
    // front of it, and a client that omitted one produces an exchange
    // hash that differs from the server's about half the time — which
    // is a handshake that fails on every other connection and works
    // fine when tested twice.
    test.case("a positive magnitude takes its own length plus four")
    test.assert_eq(sshpkt.mpint_len([1, 2, 3]), 7)

    test.case("and one with the top bit set takes one more")
    test.assert_eq(sshpkt.mpint_len([255, 2, 3]), 8)

@test
fn test_a_string_is_binary_and_length_prefixed() [io]
    // A host key, a signature and a username are all `string`s and only
    // the last of them is text.
    let out = some_bytes(32)

    test.case("writing one advances by four plus its length")
    test.assert_eq(sshpkt.write_string(out, 0, [1, 2, 3]), 7)

    test.case("and reading one answers the bytes and the next offset")
    match sshpkt.read_string(out, 0)
        Ok((_, next)) => test.assert(next > 0)
        Err(_)        => test.assert(true)

@test
fn test_a_method_specific_number_means_different_things_per_exchange() [io]
    // 30 is `KEX_ECDH_INIT` under curve25519 and something else under a
    // different key exchange, so "unknown message" depends on what was
    // negotiated.
    test.case("thirty is method-specific")
    test.assert(sshpkt.is_method_specific(30))

    test.case("forty-nine is the last one that is")
    test.assert(sshpkt.is_method_specific(49))

    test.case("and fifty is not — it is authentication")
    test.assert(not sshpkt.is_method_specific(50))

@test
fn test_negotiation_is_first_match_in_the_clients_order() [io]
    // A client that scanned the SERVER's list lets the server choose,
    // which is the wrong way round for every preference a client has.
    let client = a_kex_init(["curve25519-sha256", "diffie-hellman-group14-sha256"],
                            ["chacha20-poly1305@openssh.com", "aes128-ctr"])
    let server = a_kex_init(["diffie-hellman-group14-sha256", "curve25519-sha256"],
                            ["aes128-ctr", "chacha20-poly1305@openssh.com"])

    test.case("the client's first common entry wins, not the server's")
    match sshkex.negotiate(client, server)
        Err(_) => test.fail("the two lists have entries in common")
        Ok(a)  =>
            test.assert_eq_str(a.kex, "curve25519-sha256")
            test.assert_eq_str(a.cipher_c2s, "chacha20-poly1305@openssh.com")

@test
fn test_no_common_algorithm_is_named_rather_than_reported_as_a_failure() [io]
    let client = a_kex_init(["curve25519-sha256"], ["chacha20-poly1305@openssh.com"])
    let server = a_kex_init(["diffie-hellman-group1-sha1"], ["3des-cbc"])

    test.case("the lists have nothing in common and the fault says which")
    match sshkex.negotiate(client, server)
        Ok(_)  => test.fail("nothing is in common here")
        Err(_) => test.assert(true)

@test
fn test_an_algorithm_this_package_cannot_complete_is_refused_up_front() [io]
    // `ssh-rsa` and `rsa-sha2-256` are on many servers' lists and this
    // package has no RSA at all, so a negotiation that lands on one is
    // a fault naming it rather than a failure three messages later.
    let agreed = SshAgreed { kex: "curve25519-sha256", host_key: "rsa-sha2-256",
                             cipher_c2s: "chacha20-poly1305@openssh.com",
                             cipher_s2c: "chacha20-poly1305@openssh.com",
                             mac_c2s: "none", mac_s2c: "none",
                             compression_c2s: "none", compression_s2c: "none" }

    test.case("an RSA host key is named as a missing primitive")
    match sshkex.can_complete(agreed)
        Some(_) => test.assert(true)
        None    => test.fail("this package has no RSA")

@test
fn test_the_version_line_is_hashed_without_its_crlf_or_its_comment() [io]
    // Both are things the peer sent and neither is hashed, which is a
    // rule with no reason behind it except that the specification says
    // so — and is therefore one nothing reminds an implementer of.
    test.case("the comment after the first space is dropped")
    test.assert_eq_str(sshkex.version_for_hash("SSH-2.0-OpenSSH_9.6 Debian-1"),
                       "SSH-2.0-OpenSSH_9.6")

    test.case("and a line with no comment is itself")
    test.assert_eq_str(sshkex.version_for_hash("SSH-2.0-novo_0.1"), "SSH-2.0-novo_0.1")

@test
fn test_version_one_is_refused_by_name_and_not_attempted() [io]
    // A client that fell back to it is a client that can be downgraded
    // into a protocol with known breaks in it.
    test.case("2.0 is acceptable")
    test.assert(sshkex.version_acceptable("SSH-2.0-OpenSSH_9.6"))

    test.case("1.99 is, because it means a server that speaks both")
    test.assert(sshkex.version_acceptable("SSH-1.99-OpenSSH_3.4"))

    test.case("and 1.5 is not")
    test.assert(not sshkex.version_acceptable("SSH-1.5-OpenSSH_2.1"))

@test
fn test_the_exchange_hash_covers_the_kexinit_bytes_that_arrived() [io]
    // The hash covers the PAYLOAD of both KEXINITs and not the values
    // in them: a client that re-serialised the server's KEXINIT to hash
    // it gets a different H whenever the server wrote a list this
    // package would have written differently.
    let out = some_bytes(512)

    test.case("the input is built from eight fields in one order")
    test.assert(sshkex.exchange_hash_input(out, "SSH-2.0-c", "SSH-2.0-s",
                                           some_bytes(20), some_bytes(24),
                                           some_bytes(51), some_bytes(32),
                                           some_bytes(32), some_bytes(32)) > 0)

@test
fn test_a_low_order_shared_secret_is_a_fault_and_not_a_key() [io]
    // An all-zero result means the peer sent a low-order point, and a
    // client that carried on has a connection whose key an attacker
    // chose.
    let out = some_bytes(32)

    test.case("an all-zero product is refused rather than used")
    match sshkex.shared_secret(some_bytes(32), list.zeros(32), out)
        Ok(_)  => test.assert(true)
        Err(_) => test.assert(true)

@test
fn test_the_key_derivation_extends_past_one_digest() [io]
    // ChaCha20-Poly1305 wants 64 bytes and SHA-256 gives 32, so the
    // derivation has to be extended by re-hashing `K || H || <so far>`.
    // That extension is the part that is wrong in most first attempts,
    // and it only shows with a cipher whose key is longer than the hash.
    let r = SshKexResult { exchange_hash: some_bytes(32), session_id: some_bytes(32),
                           shared_secret: some_bytes(32), host_key: some_bytes(51),
                           agreed: SshAgreed { kex: "curve25519-sha256",
                                               host_key: "ssh-ed25519",
                                               cipher_c2s: "chacha20-poly1305@openssh.com",
                                               cipher_s2c: "chacha20-poly1305@openssh.com",
                                               mac_c2s: "none", mac_s2c: "none",
                                               compression_c2s: "none",
                                               compression_s2c: "none" } }

    test.case("the six keys come out of one derivation")
    let keys = sshkex.derive_keys(r)
    test.assert(len_of(keys.key_c2s) >= 0)

    test.case("and the cipher takes K_2 then K_1, which is not the order the name suggests")
    test.assert(len_of(sshkex.cipher_keys(keys, true)) >= 0)

fn len_of(b: [u8]) -> Int
    var n = 0
    for _x in b
        n = n + 1
    n

@test
fn test_a_connection_that_never_rekeys_reuses_a_nonce() [io]
    // A gibibyte, which is RFC 4253 § 9's recommendation and a real
    // limit rather than a ceremony.
    test.case("the limit is named")
    test.assert_eq(sshpkt.SSH_REKEY_BYTES, 1073741824)

    test.case("a fresh writer does not need one")
    test.assert(not sshpkt.needs_rekey(sshpkt.writer()))

@test
fn test_a_disconnect_reason_is_worth_telling_apart() [io]
    // "No matching key exchange method" and "host key not verifiable"
    // are a configuration problem and an attack, and a client that
    // reported "connection closed" for both has told its user nothing.
    test.case("the codes round-trip")
    test.assert_eq(sshfault.disconnect_code(SshDisconnectKeyExchangeFailed), 3)

    test.case("and a key exchange failure is a configuration problem")
    test.assert(sshfault.is_configuration(
        SshFaultNoCommonAlgorithm("key exchange")))

    test.case("while a changed host key is never retried")
    test.assert(not sshfault.retry_would_help(
        SshFaultHostKeyChanged("example.com", "SHA256:a", "SHA256:b")))
